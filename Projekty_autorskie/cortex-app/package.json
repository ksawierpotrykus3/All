{
  "name": "cortex-app",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --port=3000 --host=0.0.0.0",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "electron:build": "electron-vite build && electron-builder",
    "clean": "rimraf dist out",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cosmos.gl/graph": "^3.4.1",
    "@uiw/react-markdown-preview": "^5.2.1",
    "@xyflow/react": "^12.11.6",
    "force-graph": "^1.51.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "electron-vite": "^4.0.0",
    "esbuild": "^0.25.12",
    "jsdom": "^29.1.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.cortex.app",
    "productName": "Cortex",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/@rollup/rollup*/**/*.node"
    ],
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
