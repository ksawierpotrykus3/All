/łowca\"\n\nIMPORT_RE = re.compile(r\"(?:from\\s+['\\\"]([^'\\\"]+)['\\\"]|import\\s+['\\\"]([^'\\\"]+)['\\\"]|require\\(['\\\"]([^'\\\"]+)['\\\"]\\))\")\n\n\ndef ext_type(path):\n    ext = os.path.splitext(path)[1].lower()\n    if ext in CODE_EXTS:\n        return \"kod\"\n    if ext == \".md\":\n        return \"markdown\"\n    if ext == \".json\":\n        return \"json\"\n    if ext == \".txt\":\n        return \"txt\"\n    return \"inny\"\n\n\ndef category(path):\n    p = path.replace(\"\\\\\", \"/\").lower()\n    if p.startswith(CORTEX.replace(\"\\\\\", \"/\").lower()):\n        return \"cortex-app\"\n    if p.startswith(LOWCA.replace(\"\\\\\", \"/\").lower()):\n        rel = p[len(LOWCA.replace(\"\\\\\", \"/\").lower()):].lstrip(\"/\")\n        if rel.startswith(\"facebook\"):\n            return \"łowca/facebook\"\n        if rel.startswith(\"reddit\"):\n            return \"łowca/reddit\"\n        if rel.startswith(\"youtube\"):\n            return \"łowca/youtube\"\n        return \"łowca/inne\"\n    return \"inne\"\n\n\n# --- parser atomów ---------------------------------------------------------\n\ndef _split_long(text, max_chars=MAX_ATOM_CHARS):\n    if len(text) <= max_chars:\n        return [text]\n    parts = re.split(r\"\\n\\s*\\n\", text)\n    out, buf = [], \"\"\n    for p in parts:\n        if len(buf) + len(p) <= max_chars:\n            buf = (buf + \"\\n\\n\" + p).strip() if buf else p\n        else:\n            if buf:\n                out.append(buf)\n            buf = p\n    if buf:\n        out.append(buf)\n    return out or [text]\n\n\ndef parse_markdown(text):\n    lines = text.split(\"\\n\")\n    atoms, cur = [], []\n    for ln in lines:\n        if re.match(r\"^#{1,4}\\s+\", ln):\n            if cur:\n                atoms.append(\"\\n\".join(cur).strip())\n            cur = [ln]\n        else:\n            cur.append(ln)\n    if cur:\n        atoms.append(\"\\n\".join(cur).strip())\n    out = []\n    for a in atoms:\n        if a.strip():\n            out.extend(_split_long(a))\n    return out\n\n\ndef _find_brace_end(text, start):\n    depth = 0\n    in_str = None\n    i = start\n    while i < len(text):\n        c = text[i]\n        if in_str:\n            if c == '\\\\':\n                i += 2\n                continue\n            if c == in_str:\n                in_str = None\n            i += 1\n            continue\n        if c in ('\"', \"'\", '`'):\n            in_str = c\n        elif c in '{([':\n            depth += 1\n        elif c in '})]':\n            depth -= 1\n            if depth == 0:\n                return i + 1\n        i += 1\n    return len(text)\n\n\ndef _find_py_end(lines, start):\n    for j in range(start + 1, len(lines)):\n        if lines[j].strip() == '':\n            continue\n        if not lines[j].startswith((' ', '\\t')):\n            return j\n    return len(lines)\n\n\ndef _parse_code_py(text):\n    lines = text.split(\"\\n\")\n    starts = [i for i, ln in enumerate(lines) if re.match(r\"^(def |class |async def )\", ln)]\n    if not starts:\n        return _split_long(text)\n    atoms = []\n    if starts[0] > 0:\n        hdr = \"\\n\".join(lines[:starts[0]]).strip()\n        if hdr:\n            atoms.append(hdr)\n    for s in starts:\n        e = _find_py_end(lines, s)\n        body = \"\\n\".join(lines[s:e]).strip()\n        atoms.extend(_split_long(body))\n    return [a for a in atoms if a.strip()]\n\n\ndef _parse_code_c(text):\n    lines = text.split(\"\\n\")\n    pat = re.compile(r\"^(export\\s+)?(function\\s|class\\s|const\\s|let\\s|var\\s|interface\\s|type\\s|enum\\s)\")\n    starts = [i for i, ln in enumerate(lines) if pat.match(ln)]\n    if not starts:\n        return _split_long(text)\n    atoms = []\n    if starts[0] > 0:\n        hdr = \"\\n\".join(lines[:starts[0]]).strip()\n        if hdr:\n            atoms.append(hdr)\n    for s in starts:\n        pos = sum(len(l) + 1 for l in lines[:s])\n        e_pos = _find_brace_end(text, pos)\n        end_line = len(text[:e_pos].split(\"\\n\"))\n        if end_line <= s:\n            end_line = s + 1\n        body = \"\\n\".join(lines[s:end_line]).strip()\n        atoms.extend(_split_long(body))\n    return [a for a in atoms if a.strip()]\n\n\ndef parse_code(text, ext):\n    return _parse_code_py(text) if ext == \".py\" else _parse_code_c(text)\n\n\ndef parse_text(text):\n    paras = [p.strip() for p in re.split(r\"\\n\\s*\\n\", text) if p.strip()]\n    atoms, buf = [], \"\"\n    for p in paras:\n        cand = (buf + \"\\n\\n\" + p).strip() if buf else p\n        if len(cand) <= 1500:\n            buf = cand\n        else:\n            if buf:\n                atoms.append(buf)\n            buf = p\n    if buf:\n        atoms.append(buf)\n    return atoms or _split_long(text)\n\n\ndef parse_atoms(path, text):\n    ext = os.path.splitext(path)[1].lower()\n    if ext == \".md\":\n        return [a for a in parse_markdown(text) if a.strip()]\n    if ext in CODE_EXTS:\n        return [a for a in parse_code(text, ext) if a.strip()]\n    if ext == \".json\":\n        return _split_long(text)\n    return [a for a in parse_text(text) if a.strip()]\n\n\ndef extract_imports(text):\n    out = []\n    for m in IMPORT_RE.finditer(text):\n        v = next((g for g in m.groups() if g), None)\n        if v:\n            out.append(v)\n    return out\n\n\n# --- baza ------------------------------------------------------------------\n\ndef init_db():\n    con = sqlite3.connect(DB_PATH)\n    con.execute(\"DROP TABLE IF EXISTS nodes\")\n    con.execute(\"DROP TABLE IF EXISTS edges\")\n    con.execute(\"\"\"CREATE TABLE nodes (\n        id INTEGER PRIMARY KEY AUTOINCREMENT,\n        source TEXT, path TEXT, name TEXT, type TEXT, cat TEXT,\n        text TEXT, ord INTEGER, content_hash TEXT,\n        x REAL, y REAL, emb BLOB\n    )\"\"\")\n    con.execute(\"\"\"CREATE TABLE edges (\n        id INTEGER PRIMARY KEY AUTOINCREMENT,\n        source_node INTEGER, target_node INTEGER, kind TEXT\n    )\"\"\")\n    con.execute(\"CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT)\")\n    con.commit()\n    return con\n\n\ndef content_hash(text):\n    return hashlib.sha1(text.encode(\"utf-8\", \"ignore\")).hexdigest()\n\n\ndef iter_text_files():\n    for src in SOURCES:\n        if not os.path.isdir(src):\n            continue\n        for dirpath, dirnames, filenames in os.walk(src):\n            dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]\n            for fn in filenames:\n                ext = os.path.splitext(fn)[1].lower()\n                if ext not in TEXT_EXTS:\n                    continue\n                fp = os.path.join(dirpath, fn)\n                try:\n                    if os.path.getsize(fp) > MAX_FILE_BYTES:\n                        continue\n                except OSError:\n                    continue\n                yield fp\n\n\n# --- główna pętla ----------------------------------------------------------\n\ndef main():\n    print(\"1) Parser atomów + SQLite (bez data/)...\")\n    con = init_db()\n    files = list(iter_text_files())\n    print(\"   plików:\", len(files))\n\n    rows = []  # (fp, name, typ, cat, text, ord, hash)\n    imports_map = {}  # fp -> list of import strings\n\n    for fp in files:\n        try:\n            with open(fp, \"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n                raw = f.read()\n        except Exception:\n            continue\n        atoms = parse_atoms(fp, raw)\n        name = os.path.basename(fp)\n        for i, a in enumerate(atoms):\n            label = name if len(atoms) == 1 else f\"{name}::{i}\"\n            rows.append((fp, label, ext_type(fp), category(fp), a, i, content_hash(a)))\n        if os.path.splitext(fp)[1].lower() in CODE_EXTS:\n            imports_map[fp] = extract_imports(raw)\n\n    print(\"   atomów:\", len(rows))\n\n    # wstaw + embedding\n    print(\"2) BGE-M3 (GPU) — embedding atomów...\")\n    from sentence_transformers import SentenceTransformer\n    model = SentenceTransformer(MODEL_DIR, device=\"cuda\")\n    model.max_seq_length = 512\n    texts = [r[4] for r in rows]\n    embs = model.encode(texts, batch_size=8, show_progress_bar=True,\n                        normalize_embeddings=True, convert_to_numpy=True)\n\n    for (fp, name, typ, cat, text, ordv, h), emb in zip(rows, embs):\n        con.execute(\n            \"INSERT INTO nodes (source, path, name, type, cat, text, ord, content_hash, emb) VALUES (?,?,?,?,?,?,?,?,?)\",\n            (\"file\", fp, name, typ, cat, text, ordv, h, emb.tobytes()))\n\n    print(\"3) Globalny UMAP...\")\n    import numpy as np\n    nrows = con.execute(\"SELECT id, emb FROM nodes\").fetchall()\n    ids = [r[0] for r in nrows]\n    all_embs = np.vstack([np.frombuffer(r[1], dtype=np.float32) for r in nrows])\n    import umap\n    reducer = umap.UMAP(n_components=2, n_neighbors=15, min_dist=0.1,\n                        random_state=42, metric=\"cosine\")\n    coords = reducer.fit_transform(all_embs)\n    xs, ys = coords[:, 0], coords[:, 1]\n    nx = (xs - xs.min()) / (xs.max() - xs.min() or 1)\n    ny = (ys - ys.min()) / (ys.max() - ys.min() or 1)\n    for i, nid in enumerate(ids):\n        con.execute(\"UPDATE nodes SET x=?, y=? WHERE id=?\", (float(nx[i]), float(ny[i]), nid))\n\n    print(\"4) Budowanie relacji (edges)...\")\n    # 4a. same-file edges\n    same = con.execute(\"SELECT id, path, ord FROM nodes ORDER BY path, ord\").fetchall()\n    by_path = {}\n    for nid, path, ordv in same:\n        by_path.setdefault(path, []).append((ordv, nid))\n    edge_pairs = set()\n    for path, items in by_path.items():\n        items.sort()\n        for k in range(1, len(items)):\n            edge_pairs.add((items[k-1][1], items[k][1], \"same-file\"))\n\n    # 4b. import edges: połącz pierwszy atom pliku z pierwszym atomem importowanego pliku\n    path_to_first = {}\n    for path, items in by_path.items():\n        path_to_first[path.replace(\"\\\\\", \"/\").lower()] = items[0][1]\n\n    for fp, imps in imports_map.items():\n        src_id = path_to_first.get(fp.replace(\"\\\\\", \"/\").lower())\n        if src_id is None:\n            continue\n        base = os.path.dirname(fp)\n        for imp in imps:\n            if not imp.startswith('.'):\n                continue\n            target = os.path.normpath(os.path.join(base, imp))\n            found = None\n            for ext in ['', '.ts', '.tsx', '.js', '.jsx', '.py', '.json', '.md']:\n                cand = (target + ext).replace(\"\\\\\", \"/\").lower()\n                if cand in path_to_first:\n                    found = path_to_first[cand]\n                    break\n            if found and found != src_id:\n                edge_pairs.add((src_id, found, \"import\"))\n\n    for s, t, kind in edge_pairs:\n        con.execute(\"INSERT INTO edges (source_node, target_node, kind) VALUES (?,?,?)\", (s, t, kind))\n    con.commit()\n    print(\"   krawędzi:\", len(edge_pairs))\n\n    print(\"5) Generowanie kosmos.html...\")\n    nodes = con.execute(\"SELECT id, name, type, cat, path, text, x, y FROM nodes WHERE x IS NOT NULL\").fetchall()\n    edges = con.execute(\"SELECT source_node, target_node, kind FROM edges\").fetchall()\n    make_html(nodes, edges)\n    con.close()\n    print(\"GOTOWE.\")\n\n\n# --- HTML ------------------------------------------------------------------\n\ndef make_html(nodes, edges):\n    COLORS = {\"kod\": \"#4da6ff\", \"markdown\": \"#b06ff0\", \"json\": \"#ffd24d\",\n              \"txt\": \"#58d68d\", \"inny\": \"#aaaaaa\"}\n\n    id_to_idx = {}\n    points = []\n    for (nid, name, typ, cat, path, text, x, y) in nodes:\n        id_to_idx[nid] = len(points)\n        points.append({\n            \"x\": x, \"y\": y, \"color\": COLORS.get(typ, \"#aaa\"),\n            \"label\": html.escape(name), \"path\": html.escape(path),\n            \"type\": typ, \"cat\": html.escape(cat), \"text\": html.escape(text),\n        })\n\n    # edges jako pary indeksów + kind (kolor)\n    edge_list = []\n    for s, t, kind in edges:\n        if s in id_to_idx and t in id_to_idx:\n            edge_list.append([id_to_idx[s], id_to_idx[t], kind])\n\n    # klastry: siatka; liczba + dominujący plik (nie typ rozszerzenia)\n    from collections import Counter, defaultdict\n    grid = defaultdict(list)\n    for i, p in enumerate(points):\n        grid[(int(p[\"x\"] * 24), int(p[\"y\"] * 24))].append(i)\n    cluster_list = []\n    for (gx, gy), idxs in grid.items():\n        if len(idxs) >= 3:\n            cx = sum(points[i][\"x\"] for i in idxs) / len(idxs)\n            cy = sum(points[i][\"y\"] for i in idxs) / len(idxs)\n            names = [points[i][\"label\"].split(\"::\")[0] for i in idxs]\n            top = Counter(names).most_common(1)[0][0]\n            cluster_list.append({\n                \"x\": cx, \"y\": cy, \"count\": len(idxs),\n                \"top\": top,\n                \"samples\": [points[i][\"label\"] for i in idxs[:3]],\n            })\n\n    data = json.dumps({\"points\": points, \"clusters\": cluster_list, \"edges\": edge_list}, ensure_ascii=False)\n\n    html_out = \"\"\"<!DOCTYPE html>\n<html lang=\"pl\"><head><meta charset=\"utf-8\"><title>Kosmos</title>\n<style>\nhtml,body{margin:0;height:100%;background:#05060a;color:#e6e6e6;font-family:system-ui,Segoe UI,Roboto,sans-serif;overflow:hidden;}\n#map{position:absolute;inset:0;cursor:grab;}\n#tooltip{position:absolute;pointer-events:none;background:#0d1117;border:1px solid #30363d;border-radius:6px;padding:8px 10px;font-size:12px;max-width:380px;display:none;z-index:10;}\n#hud{position:absolute;top:10px;left:10px;background:rgba(13,17,23,.85);border:1px solid #30363d;border-radius:6px;padding:8px 12px;font-size:12px;z-index:5;}\n#legend{position:absolute;bottom:10px;left:10px;background:rgba(13,17,23,.85);border:1px solid #30363d;border-radius:6px;padding:8px 12px;font-size:12px;z-index:5;}\n.lg{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px;vertical-align:middle;}\n#panel{position:absolute;top:0;right:0;width:400px;height:100%;background:#0d1117;border-left:1px solid #30363d;overflow-y:auto;display:none;z-index:20;padding:16px;box-sizing:border-box;font-size:13px;}\n#panel .close{float:right;cursor:pointer;color:#888;font-size:18px;line-height:1;}\n#panel .path{color:#8ab4f8;word-break:break-all;font-family:monospace;font-size:11px;}\n#panel pre{white-space:pre-wrap;word-break:break-word;background:#0a0e14;border:1px solid #30363d;border-radius:6px;padding:10px;font-family:Consolas,monospace;font-size:12px;color:#d0d7de;}\n</style></head><body>\n<canvas id=\"map\"></canvas>\n<div id=\"hud\">Kosmos — węzły: <b id=\"count\"></b> · krawędzie: <b id=\"ecount\"></b> · kółko=zoom · przeciągnij=przesuń · klik=otwórz</div>\n<div id=\"legend\"><span><span class=\"lg\" style=\"background:#4da6ff\"></span>kod</span> <span><span class=\"lg\" style=\"background:#b06ff0\"></span>markdown</span> <span><span class=\"lg\" style=\"background:#ffd24d\"></span>json</span> <span><span class=\"lg\" style=\"background:#58d68d\"></span>txt</span></div>\n<div id=\"tooltip\"></div>\n<div id=\"panel\"><span class=\"close\" onclick=\"this.parentNode.style.display='none'\">&times;</span><div id=\"panelbody\"></div></div>\n<script>\nconst DATA=__DATA__;\nconst canvas=document.getElementById('map'), ctx=canvas.getContext('2d');\nconst tooltip=document.getElementById('tooltip');\ndocument.getElementById('count').textContent=DATA.points.length;\ndocument.getElementById('ecount').textContent=DATA.edges.length;\nlet view={x:0,y:0,scale:0.6};\nlet down=null, moved=false;\nconst THRESH=1.5;\n\nfunction resize(){canvas.width=innerWidth;canvas.height=innerHeight;draw();}\nwindow.addEventListener('resize',resize);\n\nfunction scr(x,y){const w=canvas.width,h=canvas.height,pad=30,s=Math.min(w,h)-pad*2;return [pad+x*s*view.scale+view.x,pad+y*s*view.scale+view.y];}\n\nfunction draw(){\n  ctx.clearRect(0,0,canvas.widt