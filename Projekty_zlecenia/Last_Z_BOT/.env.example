# Backend
DATABASE_URL=sqlite:///./joaxx.db
# Generate a strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# PROD: False — schema tworzona przez migracje Alembic, nie create_all przy starcie.
# Migracje: uv run alembic -c mvp/alembic.ini upgrade head
AUTO_CREATE_TABLES=True
# PROD: True — bez działającego Redisa backend zwraca 503 zamiast pomijać rate-limit.
RATE_LIMIT_FAIL_CLOSED=True
# Domy domen sklepu Stripe (oddzielone przecinkiem) akceptowane w checkout session.
CHECKOUT_ALLOWED_DOMAINS=localhost
# Dozwolone originy CORS (oddzielone przecinkiem).
# PROD: domena produkcyjna frontendu, np. https://twoja-domena.pl
ALLOWED_ORIGINS=http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Redis
REDIS_URL=redis://localhost:6379/0

# License
LICENSE_GRACE_PERIOD_HOURS=24
# Klucz prywatny do podpisywania odpowiedzi /license/validate (Ed25519).
# Wygeneruj: uv run python -c "from mvp.backend.license_signing import generate_keypair; p,u=generate_keypair(); print(p); print(u)"
# Wartość: cały PEM (BEGIN PRIVATE KEY ... END PRIVATE KEY) w jednej linii.
LICENSE_PRIVATE_KEY_PEM=
# PROD: False — bez skonfigurowanego klucza backend zwraca 503 zamiast podpisać odpowiedź.
ALLOW_UNSIGNED_LICENSE_RESPONSE=False