# Intentionally shorter than 32 chars: copying .env unchanged MUST fail startup
# validation (fail-closed) — forces you to set a real secret.
JWT_SECRET=change-me

# Stripe keys: replace the placeholders below with real values, otherwise
# checkout and webhooks will be non-functional. The backend logs a warning at
# startup when these are left empty or as the literal placeholders.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

ALLOWED_ORIGINS=https://panel.twojadomena.pl
CHECKOUT_ALLOWED_DOMAINS=panel.twojadomena.pl